#include <winver.h>
1 24 "sleepv.exe.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,1,0,0
 PRODUCTVERSION 1,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904e4"
        BEGIN
            VALUE "CompanyName", "sleepv project"
            VALUE "FileDescription", "sleep with a visual countdown"
            VALUE "FileVersion", "1.1.0"
            VALUE "InternalName", "sleepv"
            VALUE "LegalCopyright", "Unlicense / public domain"
            VALUE "OriginalFilename", "sleepv.exe"
            VALUE "ProductName", "sleepv for Windows"
            VALUE "ProductVersion", "1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1252
    END
END
